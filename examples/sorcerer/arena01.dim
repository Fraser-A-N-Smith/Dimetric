format = "dimetric"
version = 1

[scene]
root = "n_root0000"

# ── The arena ─────────────────────────────────────
#
# One room of the sorcerer slice. The projectile pool at the bottom is authored
# rather than spawned: the script API cannot create a node, so every projectile
# the game will ever fire exists here from the start, parked and invisible.
[[node]]
id = "n_root0000"
kind = "Node2D"
name = "Arena01"
script = "script:scripts/arena.lua"

[[node]]
id = "n_book0001"
kind = "Node"
name = "Spellbook"
parent = "n_root0000"          # /Arena01
script = "script:scripts/spellbook.lua"

[[node]]
id = "n_floor000"
kind = "TileLayer"
name = "Floor"
parent = "n_root0000"          # /Arena01
layer = -1
tileset = "asset:tilesets/dungeon"

[[node]]
id = "n_player00"
kind = "Collider"
name = "Player"
parent = "n_root0000"          # /Arena01
script = "script:scripts/player.lua"
pos = [64.0, 96.0]
tags = ["player"]
collision_mask = 3
radius = 6.0
shape = "Circle"

[[node]]
id = "n_plsprt00"
kind = "Sprite2D"
name = "Body"
parent = "n_player00"          # /Arena01/Player
z = 10
texture = "asset:sprites/sorcerer"

# Parented to the player, so it follows without a script. A camera that needed
# one would be a script that has to run in a fixed order relative to movement.
[[node]]
id = "n_camera00"
kind = "Camera2D"
name = "View"
parent = "n_player00"          # /Arena01/Player
current = true

[[node]]
id = "n_skel0001"
kind = "Instance"
name = "Skeleton_01"
parent = "n_root0000"          # /Arena01
scene = "scene:prefabs/skeleton"
pos = [176.0, 72.0]

[[node]]
id = "n_skel0002"
kind = "Instance"
name = "Skeleton_02"
parent = "n_root0000"          # /Arena01
scene = "scene:prefabs/skeleton"
pos = [192.0, 120.0]

[[node]]
id = "n_wrth0001"
kind = "Instance"
name = "Wraith_01"
parent = "n_root0000"          # /Arena01
scene = "scene:prefabs/wraith"
pos = [208.0, 48.0]

[[node]]
id = "n_wrth0002"
kind = "Instance"
name = "Wraith_02"
parent = "n_root0000"          # /Arena01
scene = "scene:prefabs/wraith"
pos = [216.0, 144.0]

[[node]]
id = "n_brut0001"
kind = "Instance"
name = "Brute_01"
parent = "n_root0000"          # /Arena01
scene = "scene:prefabs/brute"
pos = [232.0, 96.0]

[[node]]
id = "n_proj0000"
kind = "Collider"
name = "Bolt_00"
parent = "n_root0000"          # /Arena01
script = "script:scripts/projectile.lua"
visible = false
tags = ["projectile"]
collision_layer = 4
collision_mask = 2
radius = 3.0
shape = "Circle"

[[node]]
id = "n_ps00spr0"
kind = "Sprite2D"
name = "Glow"
parent = "n_proj0000"          # /Arena01/Bolt_00
z = 20
blend = "Additive"
texture = "asset:sprites/bolt"

[[node]]
id = "n_ps00lit0"
kind = "Light2D"
name = "Light"
parent = "n_proj0000"          # /Arena01/Bolt_00

format = "dimetric"
version = 1

[scene]
root = "n_root0000"

# ── The arena ─────────────────────────────────────
#
# One room of the sorcerer slice. Nothing transient is authored here: enemies
# arrive as waves and spells as projectiles, both spawned by the arena script.
[[node]]
id = "n_root0000"
kind = "Node2D"
name = "Arena01"
script = "script:scripts/arena.lua"

[[node]]
id = "n_floor000"
kind = "TileLayer"
name = "Floor"
parent = "n_root0000"          # /Arena01
layer = -1
tileset = "asset:tilesets/dungeon"

[[node]]
id = "n_player00"
kind = "Collider"
name = "Player"
parent = "n_root0000"          # /Arena01
script = "script:scripts/player.lua"
pos = [64.0, 96.0]
tags = ["player"]
collision_mask = 3
radius = 6.0
shape = "Circle"

[[node]]
id = "n_plsprt00"
kind = "Sprite2D"
name = "Body"
parent = "n_player00"          # /Arena01/Player
z = 10
texture = "asset:sprites/sorcerer"

# Parented to the player, so it follows without a script. A camera that needed
# one would be a script that has to run in a fixed order relative to movement.
[[node]]
id = "n_camera00"
kind = "Camera2D"
name = "View"
parent = "n_player00"          # /Arena01/Player
current = true

# ── Walls ─────────────────────────────────────────
#
# The room had no bounds, so the player could walk off the floor and fight
# nothing. Four static bodies on the floor's painted extent (0,0)-(384,256),
# sixteen thick and overlapping at the corners so there is no gap to slip
# through diagonally. Layer 1, which is what the player and the enemies already
# test against; projectiles are on mask 2 and still fly over, which is what a
# spell should do.
[[node]]
id = "n_wallw000"
kind = "Collider"
name = "WallWest"
parent = "n_root0000"          # /Arena01
pos = [-8.0, 128.0]
tags = ["wall"]
is_static = true
size = [16.0, 288.0]

[[node]]
id = "n_walle000"
kind = "Collider"
name = "WallEast"
parent = "n_root0000"          # /Arena01
pos = [392.0, 128.0]
tags = ["wall"]
is_static = true
size = [16.0, 288.0]

[[node]]
id = "n_walln000"
kind = "Collider"
name = "WallNorth"
parent = "n_root0000"          # /Arena01
pos = [192.0, -8.0]
tags = ["wall"]
is_static = true
size = [416.0, 16.0]

[[node]]
id = "n_walls000"
kind = "Collider"
name = "WallSouth"
parent = "n_root0000"          # /Arena01
pos = [192.0, 264.0]
tags = ["wall"]
is_static = true
size = [416.0, 16.0]

[[chunk]]
layer = "n_floor000"           # /Arena01/Floor
at = [0, 0]
data = "24:1 8:0 24:1 8:0 24:1 8:0 4:1 10:3 10:1 8:0 4:1 10:3 10:1 8:0 4:1 10:3 10:1 8:0 4:1 10:3 10:1 8:0 4:1 10:3 10:1 8:0 4:1 10:3 10:1 8:0 4:1 10:3 10:1 8:0 24:1 8:0 24:1 8:0 24:1 8:0 24:1 8:0 24:1 8:0 24:1 520:0"

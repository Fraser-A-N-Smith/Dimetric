format = "dimetric"
version = 1

[scene]
root = "n_sk_root0"

# The collider IS the body. Physics moves this node, and anything that should
# move with the skeleton parents under it.

[[node]]
id = "n_sk_root0"
kind = "Collider"
name = "Skeleton"
script = "script:scripts/skeleton.lua"
tags = ["enemy"]
shape = "Circle"
radius = 7.0
collision_layer = 2
collision_mask = 3

[[node]]
id = "n_sk_stats"
kind = "Node"
name = "Stats"
parent = "n_sk_root0"

[[node]]
id = "n_sk_hurt0"
kind = "Area"
name = "Hurtbox"
parent = "n_sk_root0"
shape = "Circle"
radius = 9.0
collision_layer = 2
collision_mask = 4
